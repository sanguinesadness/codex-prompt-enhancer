{
  "name": "codex-prompt-enhancer",
  "displayName": "Codex Prompt Enhancer",
  "description": "Enhances the current unsent Codex prompt in Cursor on macOS while preserving inline references and attachment chips.",
  "version": "0.1.1",
  "publisher": "sanguinesadness",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexPromptEnhancer.enhanceCurrentPrompt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexPromptEnhancer.enhanceCurrentPrompt",
        "title": "Enhance Current Prompt",
        "category": "Codex Prompt Enhancer"
      }
    ],
    "keybindings": [
      {
        "command": "codexPromptEnhancer.enhanceCurrentPrompt",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "isMac"
      }
    ],
    "configuration": {
      "title": "Codex Prompt Enhancer",
      "properties": {
        "codexPromptEnhancer.codexPath": {
          "type": "string",
          "default": "~/.local/bin/codex",
          "description": "Absolute path or home-relative path to the Codex CLI executable."
        },
        "codexPromptEnhancer.model": {
          "type": "string",
          "default": "gpt-5.6-luna",
          "description": "Codex model used only for prompt enhancement. Leave empty to use the Codex CLI default."
        },
        "codexPromptEnhancer.reasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "low",
          "description": "Reasoning effort used for prompt enhancement."
        },
        "codexPromptEnhancer.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum number of seconds allowed for one enhancement request."
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "tsc --watch -p ./",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:compile": "rm -rf .test-dist && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/*.test.js tests/privacyScanner.test.cjs",
    "test:native": "zsh scripts/test-native.sh",
    "privacy:check": "node scripts/privacy-check.cjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:native && npm run privacy:check",
    "build:native": "bash scripts/build-native-helper.sh",
    "build": "npm run build:native && npm run clean && npm run compile",
    "package:vsix": "bash scripts/package-local.sh",
    "verify:package": "python3 scripts/verify-package.py",
    "install:local": "bash scripts/install-local.sh",
    "ci": "npm run check && npm run package:vsix && npm run verify:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "18.15.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "codex",
    "cursor",
    "prompt",
    "prompt enhancement",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sanguinesadness/codex-prompt-enhancer.git"
  },
  "homepage": "https://github.com/sanguinesadness/codex-prompt-enhancer#readme",
  "bugs": {
    "url": "https://github.com/sanguinesadness/codex-prompt-enhancer/issues"
  }
}
